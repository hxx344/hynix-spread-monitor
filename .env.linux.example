# Copy to /etc/hynix-spread.env for systemd, or .env.linux for npm run start:linux.
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
APP_USERNAME=admin
# Set a unique password of at least 12 characters before starting.
APP_PASSWORD=
# systemd creates and owns this directory via StateDirectory.
ALERT_DATA_DIR=/var/lib/hynix-spread
