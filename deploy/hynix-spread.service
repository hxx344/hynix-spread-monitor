[Unit]
Description=Hynix Spread dashboard and Feishu alert monitor
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=hynix
Group=hynix
WorkingDirectory=/opt/hynix-spread
Environment=NODE_ENV=production
EnvironmentFile=/etc/hynix-spread.env
ExecStart=/usr/bin/env node --experimental-strip-types /opt/hynix-spread/server/linux.mjs
Restart=on-failure
RestartSec=5
TimeoutStopSec=25
StateDirectory=hynix-spread
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
